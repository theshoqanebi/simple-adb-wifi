<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fog"
    android:orientation="vertical"
    android:textDirection="ltr"
    tools:context="com.theshoqanebi.adbwifi.SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_64dp"
        android:minHeight="@dimen/_64dp"
        app:navigationContentDescription="@string/navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/ink"
        app:title="@string/settings"
        app:titleTextAppearance="@style/TextAppearance.AdbWifi.Title" />

    <LinearLayout
        android:id="@+id/portRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_72dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_24dp"
        android:paddingTop="@dimen/_12dp"
        android:paddingEnd="@dimen/_24dp"
        android:paddingBottom="@dimen/_12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_port"
                android:textAppearance="@style/TextAppearance.AdbWifi.Status" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:text="@string/settings_port_description"
                android:textAppearance="@style/TextAppearance.AdbWifi.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/portValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16dp"
            android:textAppearance="@style/TextAppearance.AdbWifi.Code"
            android:textSize="@dimen/_16sp"
            tools:text="5555" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/themeRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_72dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_24dp"
        android:paddingTop="@dimen/_12dp"
        android:paddingEnd="@dimen/_24dp"
        android:paddingBottom="@dimen/_12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_theme"
                android:textAppearance="@style/TextAppearance.AdbWifi.Status" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2dp"
                android:text="@string/settings_theme_description"
                android:textAppearance="@style/TextAppearance.AdbWifi.Caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/themeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16dp"
            android:textAppearance="@style/TextAppearance.AdbWifi.Body"
            tools:text="@string/theme_system" />
    </LinearLayout>
</LinearLayout>
