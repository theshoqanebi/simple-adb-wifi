<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fog"
    android:orientation="vertical"
    android:textDirection="ltr"
    tools:context="com.theshoqanebi.adbwifi.RootlessActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_64dp"
        android:minHeight="@dimen/_64dp"
        app:navigationContentDescription="@string/navigate_up"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/ink"
        app:title="@string/rootless"
        app:titleTextAppearance="@style/TextAppearance.AdbWifi.Title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/_24dp"
            android:paddingTop="@dimen/_8dp"
            android:paddingEnd="@dimen/_24dp"
            android:paddingBottom="@dimen/_40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rootless_intro"
                android:textAppearance="@style/TextAppearance.AdbWifi.Body"
                android:textColor="@color/ink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_28dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="1"
                    tools:ignore="HardcodedText"
                    android:textAppearance="@style/TextAppearance.AdbWifi.Code"
                    android:textColor="@color/slate_text"
                    android:textSize="@dimen/_16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_1_title"
                        android:textAppearance="@style/TextAppearance.AdbWifi.StepTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4dp"
                        android:text="@string/step_1_body"
                        android:textAppearance="@style/TextAppearance.AdbWifi.Body" />

                    <Button
                        android:id="@+id/openDeveloper"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10dp"
                        android:text="@string/developer_options_button"
                        android:textColor="@color/button_text" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_28dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="2"
                    tools:ignore="HardcodedText"
                    android:textAppearance="@style/TextAppearance.AdbWifi.Code"
                    android:textColor="@color/slate_text"
                    android:textSize="@dimen/_16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_2_title"
                        android:textAppearance="@style/TextAppearance.AdbWifi.StepTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4dp"
                        android:text="@string/step_2_body"
                        android:textAppearance="@style/TextAppearance.AdbWifi.Body" />

                    <TextView
                        style="@style/Widget.AdbWifi.CodeBlock"
                        android:layout_marginTop="@dimen/_10dp"
                        android:text="@string/step_2_command" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_28dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="3"
                    tools:ignore="HardcodedText"
                    android:textAppearance="@style/TextAppearance.AdbWifi.Code"
                    android:textColor="@color/slate_text"
                    android:textSize="@dimen/_16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_3_title"
                        android:textAppearance="@style/TextAppearance.AdbWifi.StepTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4dp"
                        android:text="@string/step_3_body"
                        android:textAppearance="@style/TextAppearance.AdbWifi.Body" />

                    <TextView
                        style="@style/Widget.AdbWifi.CodeBlock"
                        android:layout_marginTop="@dimen/_10dp"
                        android:text="@string/step_3_command" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_28dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="4"
                    tools:ignore="HardcodedText"
                    android:textAppearance="@style/TextAppearance.AdbWifi.Code"
                    android:textColor="@color/slate_text"
                    android:textSize="@dimen/_16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_4_title"
                        android:textAppearance="@style/TextAppearance.AdbWifi.StepTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4dp"
                        android:text="@string/step_4_body"
                        android:textAppearance="@style/TextAppearance.AdbWifi.Body" />

                    <TextView
                        style="@style/Widget.AdbWifi.CodeBlock"
                        android:layout_marginTop="@dimen/_10dp"
                        android:text="@string/step_4_command" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_28dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/_32dp"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="5"
                    tools:ignore="HardcodedText"
                    android:textAppearance="@style/TextAppearance.AdbWifi.Code"
                    android:textColor="@color/slate_text"
                    android:textSize="@dimen/_16sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_5_title"
                        android:textAppearance="@style/TextAppearance.AdbWifi.StepTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4dp"
                        android:text="@string/step_5_body"
                        android:textAppearance="@style/TextAppearance.AdbWifi.Body" />

                    <TextView
                        style="@style/Widget.AdbWifi.CodeBlock"
                        android:layout_marginTop="@dimen/_10dp"
                        android:text="@string/step_5_command" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
