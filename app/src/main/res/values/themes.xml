<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.AdbWifi" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/fog</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorError">@color/error</item>
        <item name="colorSurface">@color/fog</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/slate_text</item>
        <item name="colorSurfaceContainerHigh">@color/fog</item>
        <item name="colorOutline">@color/slate</item>
        <item name="android:colorBackground">@color/fog</item>
        <item name="android:windowBackground">@color/fog</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/slate_text</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
    </style>

    <style name="Theme.AdbWifi" parent="Base.Theme.AdbWifi" />

    <!-- Type scale: 14 / 16 / 21 / 28, plus the address readout, which autosizes up to 48. -->
    <style name="TextAppearance.AdbWifi.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/_21sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.AdbWifi.Status" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/_16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.AdbWifi.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/_16sp</item>
        <item name="android:textColor">@color/slate_text</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="TextAppearance.AdbWifi.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/_14sp</item>
        <item name="android:textColor">@color/slate_text</item>
    </style>

    <style name="TextAppearance.AdbWifi.Readout" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.AdbWifi.Code" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/jetbrains_mono_medium</item>
        <item name="fontFamily">@font/jetbrains_mono_medium</item>
        <item name="android:textSize">@dimen/_14sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.AdbWifi.StepTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/_16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <!-- A command the user types on their computer. -->
    <style name="Widget.AdbWifi.CodeBlock" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/code_block</item>
        <item name="android:paddingStart">@dimen/_14dp</item>
        <item name="android:paddingEnd">@dimen/_14dp</item>
        <item name="android:paddingTop">@dimen/_12dp</item>
        <item name="android:paddingBottom">@dimen/_12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.AdbWifi.Code</item>
        <item name="android:textIsSelectable">true</item>
    </style>
</resources>
