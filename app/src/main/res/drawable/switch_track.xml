<?xml version="1.0" encoding="utf-8"?>
<!-- Track of the ADB toggle, sized like the original 220x110dp on/off image. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
	<item android:state_enabled="false">
		<shape android:shape="rectangle">
			<size android:width="@dimen/_220dp" android:height="@dimen/_110dp" />
			<corners android:radius="@dimen/_55dp" />
			<solid android:color="@color/mist" />
		</shape>
	</item>
	<item android:state_checked="true">
		<shape android:shape="rectangle">
			<size android:width="@dimen/_220dp" android:height="@dimen/_110dp" />
			<corners android:radius="@dimen/_55dp" />
			<solid android:color="@color/amber" />
		</shape>
	</item>
	<item>
		<shape android:shape="rectangle">
			<size android:width="@dimen/_220dp" android:height="@dimen/_110dp" />
			<corners android:radius="@dimen/_55dp" />
			<solid android:color="@color/slate" />
		</shape>
	</item>
</selector>
